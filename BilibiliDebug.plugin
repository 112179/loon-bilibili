[Script]
http-request ^https?:\/\/([a-z0-9-]+\.)*(bilibili\.com|biliapi\.net|bilivideo\.com)\// script-path=https://cdn.jsdelivr.net/gh/112179/loon-bilibili@main/scripts/debug.js, requires-body=false, timeout=10, tag=B站调试

[MITM]
hostname = *.bilibili.com, *.biliapi.net
