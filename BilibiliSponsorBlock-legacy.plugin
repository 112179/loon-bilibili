#!name = 哔哩哔哩净化（旧版 Loon）
#!desc = 旧版 Script 语法版本，适用于 Loon 3.5.1(982) 及更早版本。清理开屏/首页广告，并在播放器进度条标记 SponsorBlock 片段结束位置。
#!author = Minis / 112179
#!homepage = https://github.com/112179/loon-bilibili
#!date = 2026-11-17
#!tag = 哔哩哔哩,去广告,SponsorBlock

[Script]
http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/(splash\/list|splash\/show|feed\/index) script-path=https://cdn.jsdelivr.net/gh/112179/loon-bilibili@main/scripts/bilibili-clean.js, requires-body=true, timeout=10, tag=B站去广告
http-response ^https?:\/\/api\.bilibili\.com\/x\/player\/(wbi\/)?v2 script-path=https://cdn.jsdelivr.net/gh/112179/loon-bilibili@main/scripts/sponsorblock.js, requires-body=true, timeout=10, tag=SponsorBlock标记

[MITM]
hostname = app.bilibili.com, api.bilibili.com
